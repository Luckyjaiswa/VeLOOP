# ==========================================
# VELoop Rewards – Daily Streak System .env
# ==========================================

# Backend Configuration (set in Vercel Environment Variables)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/veloop_rewards
JWT_SECRET=veloop_super_secret_jwt_key_2026_secure_streak_token
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration (in frontend/.env)
# For local dev:  VITE_API_URL=http://localhost:5000
# For Vercel:     VITE_API_URL=  (empty, same domain)
